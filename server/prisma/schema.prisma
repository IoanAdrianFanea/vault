// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fullName     String?
  language     String?
  timezone     String?
  mustChangePassword Boolean @default(false)
  emailVerifiedAt    DateTime?
  emailVerificationToken String?  // SHA-256 hash of the raw token sent in the email

  uploadedDocuments Document[]        @relation("UploadedBy")
  projectMemberships ProjectMembership[]
  refreshTokens RefreshToken[]
  deletionLogs  DeletionLog[]  @relation("DeletedBy")
  deletedProjects Project[]    @relation("ProjectDeletedBy")
  archivedProjects Project[]   @relation("ProjectArchivedBy")
  accountStatus  AccountStatus  @default(PENDING)
  createdFilterDefinitions FilterDefinition[] @relation("FilterDefinitionCreatedBy")
}

model Project {
  id          String              @id @default(cuid())
  name        String              @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Soft delete — set when an admin deletes the project so it (and its documents)
  // land in the recycle bin instead of being destroyed immediately.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?             @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedByEmail String?

  /// Archive state (Phase 4).
  /// Derived project lifecycles:
  /// - Active: deletedAt == null && archivedAt == null
  /// - Archived: archivedAt != null && deletedAt == null
  /// - Deleted-from-Active: deletedAt != null && archivedAt == null
  /// - Deleted-from-Archived: deletedAt != null && archivedAt != null (archivedAt stays set while in recycle bin so restore returns to Archived)
  archivedAt                DateTime?
  archivedById              String?
  archivedBy                User?             @relation("ProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  archivedByEmail           String?
  archiveSizeBytes          BigInt?
  archiveOperation          ArchiveOperation?
  archiveOperationStartedAt DateTime?

  memberships ProjectMembership[]
  documents   Document[]

  @@index([deletedAt])
  @@index([archivedAt])
}

model ProjectMembership {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String   // hash of the refresh token (never store plaintext)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Document {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User           @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime       @default(now())
  status           DocumentStatus
  errorMessage     String?
  deletedAt        DateTime?

  text             DocumentText?
  filterValues     DocumentFilterValue[]

  @@index([projectId])
  @@index([uploadedById])
  @@index([deletedAt])
}

/// Admin-configurable custom filter field (Phase 3). Capped at 5 active definitions
/// by FiltersService; every user can read the list, only admins can manage it.
model FilterDefinition {
  id          String     @id @default(cuid())
  name        String     @unique
  type        FilterType
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  createdBy   User?      @relation("FilterDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  values      DocumentFilterValue[]

  @@index([order])
}

/// A single document's value for one custom filter field.
/// Only the column matching the parent FilterDefinition.type is populated;
/// the others stay null. Deleting the FilterDefinition cascades here.
model DocumentFilterValue {
  id                 String           @id @default(cuid())
  documentId         String
  document           Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  filterDefinitionId String
  filterDefinition   FilterDefinition @relation(fields: [filterDefinitionId], references: [id], onDelete: Cascade)
  valueText          String?
  valueNumber        Float?
  valueDate          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([documentId, filterDefinitionId])
  @@index([filterDefinitionId])
}

/// Audit trail for document deletions.
/// `documentId` is intentionally a plain string, not a foreign key: the log row must
/// survive the permanent purge of the document it describes. Enough context is
/// denormalised (filename, project name, actor email) that the row stays readable
/// after the Document — or even the actor's account — is gone.
model DeletionLog {
  id                   String    @id @default(cuid())
  documentId           String
  projectId            String
  projectName          String
  originalFilename     String
  storageKey           String
  actorId              String?
  actor                User?     @relation("DeletedBy", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail           String
  deletedAt            DateTime  @default(now())
  restoredAt           DateTime?
  permanentlyDeletedAt DateTime?

  @@index([documentId])
  @@index([projectId])
  @@index([actorId])
  @@index([deletedAt])
}

model DocumentText {
  documentId    String   @id
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractedText String
  pageCount     Int?
  extractedAt   DateTime @default(now())
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum ArchiveOperation {
  ARCHIVING
  UNARCHIVING
  DELETING
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum FilterType {
  TEXT
  NUMBER
  DATE
}