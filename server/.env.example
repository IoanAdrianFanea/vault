# Copy to .env and fill in. Variables are validated at start-up (src/config/env.validation.ts).

# Optional: development (default behaviour), production or test
# NODE_ENV=development
# Optional: API port (default 3000)
# PORT=3000

# SQLite database file
DATABASE_URL="file:./dev.db"

# Site origin without a trailing slash. Required when NODE_ENV=production.
# Used for CORS, the content security policy and email links.
FRONTEND_URL="http://localhost:5173"

# JWT configuration
# Secrets must be at least 32 characters and different from each other.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes: a number followed by s, m, h or d
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# Email / SMTP
# Set SMTP_HOST, SMTP_USER, SMTP_PASS and SMTP_FROM together, or leave all of them blank.
# With none set, emails are logged to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Storage
# Root folder containing active/, archived/ and deleted/
STORAGE_ROOT=./data
# Upload size limit in MB (1 to 1024). Keep the client's VITE_MAX_UPLOAD_MB the same.
MAX_UPLOAD_MB=50
# Database backups folder (default: <STORAGE_ROOT>/backups)
BACKUP_DIR=
# Automatic backups to keep (1 to 365)
BACKUP_KEEP=14
# Files larger than this many bytes are tried with gzip (default 5242880, which is 5 MB)
COMPRESSION_THRESHOLD_BYTES=5242880
# Minimum saving from 0 to 1 for the compressed copy to be kept (0.1 is 10%)
COMPRESSION_MIN_SAVINGS_RATIO=0.1
