DATABASE_URL="file:./dev.db"

# Frontend URL for CORS and email links
FRONTEND_URL="http://localhost:5173"

# JWT Configuration
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-too"
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# Email / SMTP Configuration
# Leave blank to log emails to console only (development mode)
# Use port 465 for SSL, 587 for TLS (STARTTLS)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=DocIndex <noreply@yourdomain.com>

# Storage Configuration
# Root folder containing active/, archived/ and deleted/ directories
STORAGE_ROOT=./data
# Files larger than this (in bytes) are evaluated for compression (default: 5MB)
COMPRESSION_THRESHOLD_BYTES=5242880
# Minimum savings ratio (0 to 1) required to keep compressed file (default: 10% = 0.1)
COMPRESSION_MIN_SAVINGS_RATIO=0.1

