DATABASE_URL="file:./dev.db"

# Frontend URL for CORS and email links
FRONTEND_URL="http://localhost:5173"

# JWT Configuration
# at least 32 characters each, different from each other; generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# Email / SMTP Configuration
# all or nothing; leave all blank to disable email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Storage Configuration
# Root folder containing active/, archived/ and deleted/ directories
STORAGE_ROOT=./data
# keep the client's VITE_MAX_UPLOAD_MB the same
MAX_UPLOAD_MB=50
# default <STORAGE_ROOT>/backups
BACKUP_DIR=
BACKUP_KEEP=14
# Files larger than this (in bytes) are evaluated for compression (default: 5MB)
COMPRESSION_THRESHOLD_BYTES=5242880
# Minimum savings ratio (0 to 1) required to keep compressed file (default: 10% = 0.1)
COMPRESSION_MIN_SAVINGS_RATIO=0.1


